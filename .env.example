APP_NAME=TaxFlow
APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+psycopg://taxflow:taxflow@localhost:5432/taxflow
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=https://dev.etaxflow.com,http://localhost:5173,http://127.0.0.1:5173
# API_BASE_URL=https://dev.etaxflow.com/api/v1  # set only if API is on a different domain than the frontend
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=taxflow-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
CELERY_TASK_ALWAYS_EAGER=false
# Migrations: set false only if a pre-deploy job runs `python -m app.migrate`
RUN_MIGRATIONS_ON_STARTUP=true
# Behind PgBouncer (transaction mode): direct, non-pooled URL used only by migrations
# DATABASE_DIRECT_URL=postgresql+psycopg2://user:pass@host:25060/defaultdb?sslmode=require
# Monitoring (backend/app/monitoring.py). Error tracking is off until SENTRY_DSN is set.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=500
