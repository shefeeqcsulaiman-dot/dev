# ── Production Environment Template ─────────────────────────────────────
# Copy this file to .env on your server / inject via CI-CD secrets.
# NEVER commit a .env file with real values to git.

APP_NAME=TaxFlow
APP_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL — Render, Railway, Supabase, etc.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/taxflow

# Redis — Render Redis, Upstash, etc.
REDIS_URL=redis://default:password@host:6379

# CORS — your actual frontend domain(s)
CORS_ORIGINS=https://yourdomain.com

# S3-compatible object storage (AWS S3, Cloudflare R2, Backblaze B2, etc.)
S3_ENDPOINT_URL=
S3_BUCKET=taxflow-documents
S3_ACCESS_KEY_ID=REPLACE_WITH_REAL_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_REAL_SECRET
AWS_REGION=me-south-1

# Keep false in production so long jobs run in the background
CELERY_TASK_ALWAYS_EAGER=false

# Seed account credentials — change before first deploy
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Connection pool (tune for your DB plan's max_connections)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# Bootstrap data cap per company login (records fetched per login request)
BOOTSTRAP_RECORD_CAP=10000

# Uvicorn worker count (match to CPU cores * 2 + 1, typical Render = 4)
WORKERS=4
