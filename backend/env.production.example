# ── Production Environment — DigitalOcean ────────────────────────────────
# Set these as environment variables in DigitalOcean App Platform dashboard.
# NEVER commit a file with real values to git.

APP_NAME=TaxFlow
APP_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX

ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── DigitalOcean Managed PostgreSQL ──────────────────────────────────────
# Host:     db-pgsql-nyc3-67475-do-user-38425833-0.e.db.ondigitalocean.com
# Port:     25060
# User:     doadmin
# Database: defaultdb
# SSL:      require
DATABASE_URL=postgresql+psycopg2://doadmin:<PASSWORD>@db-pgsql-nyc3-67475-do-user-38425833-0.e.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# ── DigitalOcean Managed Redis ────────────────────────────────────────────
# Create at: https://cloud.digitalocean.com/databases → New Database → Redis
REDIS_URL=rediss://default:<PASSWORD>@<redis-host>.db.ondigitalocean.com:25061

# ── CORS — update after first deploy with your actual App Platform URL ────
CORS_ORIGINS=https://etaxflow-xxxxx.ondigitalocean.app

# ── DigitalOcean Spaces (S3-compatible object storage) ───────────────────
# Create at: https://cloud.digitalocean.com/spaces → New Space (nyc3)
# Then: API → Spaces Keys → Generate New Key
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
S3_BUCKET=etaxflow-documents
S3_ACCESS_KEY_ID=REPLACE_WITH_SPACES_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SPACES_SECRET
AWS_REGION=nyc3

# ── Workers & connection pool ─────────────────────────────────────────────
WORKERS=4
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
BOOTSTRAP_RECORD_CAP=10000

# ── Celery ────────────────────────────────────────────────────────────────
CELERY_TASK_ALWAYS_EAGER=false

# ── Seed account passwords — set strong values before first deploy ─────────
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SUPERADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── OpenAI (optional — for AI assistant) ──────────────────────────────────
OPENAI_API_KEY=REPLACE_WITH_OPENAI_KEY
